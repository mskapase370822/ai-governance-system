# ─────────────────────────────────────────────────────────────────────────────
# AI Governance System — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/ai-governance
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Include both localhost and 127.0.0.1 variants so both work in development.
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# ── Email Alerts ──────────────────────────────────────────────────────────────
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
ADMIN_EMAIL=admin@yourcompany.com

# ── ML Service (optional — falls back to rule-based engine) ──────────────────
ML_SERVICE_URL=http://localhost:8000
ML_MODEL_PATH=backend/ml/models/riskModel.json

# ── SLA Targets ───────────────────────────────────────────────────────────────
SLA_TARGET_MS=200
SLA_COMPLIANCE_TARGET=99.5
