# ─────────────────────────────────────────────────────────────────────────────
# AI Governance Frontend — Environment Variables
# Copy this file to .env and adjust the values for your setup.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API base URL (must end WITHOUT a trailing slash)
# In development, leave this unset — the Vite dev-server proxy (/api → localhost:5000)
# handles routing automatically without needing CORS configuration.
# Only set this in production or when you want to bypass the proxy.
# VITE_API_URL=https://your-backend-domain.com/api
